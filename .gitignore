# ============================================================================
# kotlin-katas — .gitignore
# Covers: Kotlin/Java/Gradle + IntelliJ IDEA + OS files
# Also excludes stray .NET files (this is a Kotlin-only repo)
# ============================================================================

# ---- Gradle build artifacts ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---- Kotlin ----
.kotlin/
*.class
*.ctxt

# ---- Java / JVM ----
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.log
hs_err_pid*
replay_pid*

# ---- IntelliJ IDEA ----
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# ---- VS Code ----
.vscode/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Local environment ----
.env
.env.local
local.properties

# ---- STRAY .NET FILES (should not be here) ----
bin/
obj/
*.user
*.suo
*.csproj
*.sln

# ---- MacOS Finder ----
._*

# ---- JetBrains ----
.idea/sonarlint/
.idea/httpRequests/
.idea/dataSources/
